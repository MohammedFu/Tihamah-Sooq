# Local development uses fixture mode by default. Set this explicitly in deployed environments.
VITE_API_MODE=fixture

# Required when VITE_API_MODE=remote. A root-relative path is also supported.
VITE_API_URL=https://api.rural-market.com/api/v1

# Integer between 1000 and 120000 milliseconds.
VITE_REQUEST_TIMEOUT_MS=15000

# Optional trusted public media origin. Do not include credentials, queries, or fragments.
VITE_MEDIA_HOST=https://cdn.rural-market.com

# development, staging, production, or test.
VITE_APP_ENV=development
